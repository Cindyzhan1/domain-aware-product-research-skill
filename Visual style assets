:root {
  --paper: #f5f5ef;
  --white: #fffefa;
  --ink: #213e38;
  --muted: #53655f;
  --line: #d6dfd6;
  --green: #206251;
  --pale: #e8efe8;
  --warm: #f5ead5;
}
* { box-sizing: border-box; }
[hidden] { display: none !important; }
body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font: 400 15px/1.75 system-ui, -apple-system, "PingFang SC", sans-serif;
}
h1, h2, h3, h4, p { margin: 0; }
h1 { font-size: clamp(30px, 4.5vw, 51px); line-height: 1.22; letter-spacing: -.04em; font-weight: 600; }
h2 { font-size: 25px; line-height: 1.35; font-weight: 600; }
h3 { font-size: 18px; line-height: 1.4; font-weight: 600; }
h4 { font-size: 15px; font-weight: 600; }
strong { font-weight: 600; }
p + p { margin-top: 10px; }
a { color: var(--green); text-underline-offset: 3px; }
button { color: inherit; font: inherit; }
button, summary { cursor: pointer; }
:focus-visible { outline: 3px solid #9c611b; outline-offset: 4px; }
.wrap { width: min(1144px, calc(100% - 76px)); margin-inline: auto; }
.top { padding: 18px 0 0; color: var(--muted); font-size: 12px; }
.top .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 20px; }
.top strong, .top small { font: inherit; }
main { padding: 36px 0 60px; }
.intro { display: grid; gap: 12px; margin-bottom: 32px; }
.kicker { color: var(--muted); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; }
.lede { max-width: 800px; font-size: 17px; font-weight: 400; }
.fine, .meta { color: var(--muted); font-size: 13px; }
.light { max-width: 76ch; }
#scope {
  max-width: 800px;
  margin-top: 8px;
  background: var(--pale);
  border: 0;
  border-left: 3px solid var(--green);
  border-radius: 0 8px 8px 0;
}
.map-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 5px 16px; margin-bottom: 18px; }
.map { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: start; gap: 16px; }
.map-column { display: grid; gap: 14px; min-width: 0; }
.map-column h3 { font-size: 13px; color: var(--muted); }
.card {
  width: 100%;
  min-height: 174px;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 9px;
  text-align: left;
  padding: 21px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--white);
}
.card:hover { background: #f4f8f0; border-color: var(--green); }
.card strong { display: flex; justify-content: space-between; gap: 9px; font-size: 19px; line-height: 1.35; }
.card .arrow { color: var(--green); font-size: 14px; font-weight: 400; }
.card .benefit { margin-top: auto; padding-top: 4px; color: var(--green); font-size: 13px; font-weight: 400; }
.overview-block { margin-top: 36px; }
.overview-block > p { margin: 6px 0 14px; }
.stack, .two { display: grid; align-items: start; gap: 12px; }
.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
details { min-width: 0; border: 1px solid var(--line); border-radius: 10px; background: var(--white); }
summary { padding: 12px 17px; font-weight: 600; line-height: 1.5; }
.inset { padding: 0 17px 16px; }
.inset > * + * { margin-top: 10px; }
.inline-details { background: transparent; border: 0; }
.inline-details summary { padding: 4px 0; font-size: 13px; color: var(--green); }
.inline-details .inset { padding: 6px 0 10px; }
.status { display: inline-block; margin-right: 7px; padding: 1px 7px; border-radius: 5px; background: var(--pale); color: var(--ink); font-size: 11px; font-weight: 600; vertical-align: .08em; }
.status[data-status="H"] { background: var(--warm); color: #684613; }
.status[data-status="A"] { background: #ece9f4; color: #55456f; }
.status[data-status="Not yet researched"] { background: #e9eef1; color: #3c4d5e; }
.evidence-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 16px;
  margin: 0 0 18px;
  padding: 0;
  list-style: none;
  color: var(--muted);
  font-size: 13px;
}
.evidence-legend li { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 5px 8px; }
.evidence-legend .status { margin: 0; border: 1px solid #c4dacd; }
.evidence-legend .status[data-status="H"] { border-color: #e6d2ac; }
.evidence-legend .status[data-status="A"] { border-color: #d8cce9; }
.evidence-legend .status[data-status="Not yet researched"] { border-color: #ced8df; }
.bar { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
.back, .small-button, .source-link { color: var(--green); font-size: 13px; background: var(--white); border: 1px solid var(--line); border-radius: 20px; padding: 5px 13px; }
.source-link { display: inline-block; text-decoration: none; }
.back:hover, .small-button:hover, .source-link:hover { background: var(--pale); }
.detail-head { display: grid; gap: 8px; margin-bottom: 18px; }
.detail-head h1 { font-size: clamp(29px, 4vw, 44px); }
.tabs { display: flex; flex-wrap: wrap; gap: 5px 9px; border-bottom: 1px solid var(--line); margin-bottom: 22px; }
.tabs button { border: 0; border-bottom: 3px solid transparent; background: transparent; padding: 8px 10px; }
.tabs [aria-selected="true"] { border-bottom-color: var(--green); font-weight: 600; }
.tabs button:hover { background: var(--pale); }
.jumps { display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: 13px; }
.panel { display: grid; gap: 18px; max-width: 920px; }
.box { min-width: 0; background: var(--white); border: 1px solid var(--line); border-radius: 12px; padding: 20px 24px; }
.box > * + * { margin-top: 10px; }
.box p { max-width: 72ch; }
#explanation { background: var(--pale); border: 0; border-left: 3px solid var(--green); border-radius: 0 10px 10px 0; }
#functionality { background: transparent; border: 0; padding-inline: 0; }
.status-line { color: var(--muted); }
.stepflow { list-style: none; padding: 0; margin: 14px 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
.stepflow li { background: var(--pale); border-radius: 8px; padding: 13px 15px; }
.row { padding: 12px 0; border-top: 1px solid var(--line); }
.row > * + * { margin-top: 6px; }
.refs { overflow-wrap: anywhere; }
.term-heading { margin: 22px 0 10px; }
footer { border-top: 1px solid var(--line); padding: 16px 0; color: var(--muted); font-size: 12px; }
@media (max-width: 850px) {
  .map { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 580px) {
  .wrap { width: calc(100% - 32px); }
  main { padding-top: 24px; }
  .map, .two, .stepflow { grid-template-columns: 1fr; }
  .map-column + .map-column { margin-top: 10px; }
  .card { min-height: 0; padding: 17px; }
  .box { padding: 17px; }
  .tabs { gap: 2px; }
  .tabs button { padding: 7px 8px; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; animation: none !important; transition: none !important; }
}
